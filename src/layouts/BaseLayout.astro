---
import '../styles/global.css';
export interface Props { title?: string; description?: string; }
const { title = 'GIAF · Grupo de Investigación en Anatomía Funcional · UANL', description = 'Grupo de Investigación en Anatomía Funcional. UANL · FOD × Medicina.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content={description}/>
  <title>{title}</title>
  <link rel="icon" href="/logo-blue.png"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet"/>
</head>
<body>

<!-- Watermark: single fixed logo behind everything -->
<img src="/logo-blue.png" alt="" class="watermark-bg" aria-hidden="true"/>

<nav id="navbar">
  <a href="/" class="nav-brand">
    <img src="/logo-blue.png" alt="GIAF" class="nav-logo-img"/>
    <div class="nav-brand-text">
      <span class="nav-brand-name">GIAF</span>
      <span class="nav-brand-sub">UANL · FOD × Medicina</span>
    </div>
  </a>
  <ul class="nav-links">
    <li><a href="/">Inicio</a></li>
    <li><a href="/articulos">Artículos</a></li>
    <li><a href="/noticias">Noticias</a></li>
    <li><a href="/conocenos">Conócenos</a></li>
    <li><a href="https://instagram.com/giaf.uanl" target="_blank" class="nav-ig">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      Instagram
    </a></li>
    <li><a href="/involucrate" class="btn-nav">Involúcrate</a></li>
  </ul>
</nav>

<slot/>

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1rem;">
        <img src="/logo-blue.png" alt="GIAF" style="width:44px;height:44px;object-fit:contain;filter:brightness(0) invert(1) opacity(.7)"/>
        <div>
          <div style="font-family:'Space Mono',monospace;font-size:.82rem;font-weight:700;color:#fff;letter-spacing:.1em;">GIAF</div>
          <div style="font-size:.58rem;color:rgba(255,255,255,.4);">UANL · FOD × Medicina</div>
        </div>
      </div>
      <p style="font-size:.82rem;color:rgba(255,255,255,.45);line-height:1.75;max-width:250px;">Grupo de Investigación en Anatomía Funcional. Generando conocimiento para la comprensión del cuerpo humano en movimiento.</p>
      <div style="margin-top:1.25rem;">
        <a href="https://instagram.com/giaf.uanl" target="_blank" class="footer-social-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          @giaf.uanl
        </a>
      </div>
    </div>
    <div>
      <p class="footer-col-title">Navegación</p>
      <ul class="footer-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/articulos">Artículos</a></li>
        <li><a href="/noticias">Noticias</a></li>
        <li><a href="/conocenos">Conócenos</a></li>
        <li><a href="/involucrate">Involúcrate</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-col-title">Facultades</p>
      <ul class="footer-links">
        <li><a href="https://www.uanl.mx/unidades/fod/" target="_blank">FOD · UANL</a></li>
        <li><a href="https://www.medicina.uanl.mx/" target="_blank">Medicina · UANL</a></li>
        <li><a href="https://www.uanl.mx/" target="_blank">UANL</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-col-title">Contacto</p>
      <ul class="footer-links">
        <li><a href="mailto:giaf@uanl.mx">giaf@uanl.mx</a></li>
        <li><a href="https://instagram.com/giaf.uanl" target="_blank">@giaf.uanl</a></li>
        <li><a href="#">San Nicolás de los Garza, NL</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-copy">© GIAF · UANL 2026 — Todos los derechos reservados</span>
    <div class="footer-badges">
      <span class="footer-badge">ASTRO 4</span>
      <span class="footer-badge">OPEN ACCESS</span>
    </div>
  </div>
</footer>

<script>
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => { navbar?.classList.toggle('scrolled', window.scrollY > 30); }, { passive:true });
  const revealEls = document.querySelectorAll('.reveal');
  const obs = new IntersectionObserver((entries) => { entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); } }); }, { threshold:0.1, rootMargin:'0px 0px -40px 0px' });
  revealEls.forEach(el => obs.observe(el));
</script>
</body>
</html>
