  .team-photo { height:320px; }
  .hero-title { font-size: clamp(3rem, 10vw, 5rem); }
}
</style>

<script>
// ── VIDEO INTRO: play fully, no cutoff ──
const introOverlay = document.getElementById('video-intro');
const introVideo   = document.getElementById('intro-video');

function hideIntro() {
  if (!introOverlay) return;
  introOverlay.style.transition = 'opacity .7s ease';
  introOverlay.style.opacity = '0';
  setTimeout(() => { if (introOverlay.parentNode) introOverlay.remove(); }, 750);
}

// Wait for video metadata to know duration, then play
introVideo.addEventListener('loadedmetadata', () => {
  introVideo.play().catch(() => {
    const skip = document.getElementById('intro-skip');
    if (skip) { skip.textContent = '▶ Toca para comenzar'; skip.style.opacity = '1'; }
  });
});

// Only hide when video truly ends
introVideo.addEventListener('ended', hideIntro);

// Click to skip
introOverlay.addEventListener('click', () => {
  introVideo.pause();
  hideIntro();
});

// If video can't load at all, hide after 8s
introVideo.addEventListener('error', () => setTimeout(hideIntro, 1000));

// Mission/Vision expand
function toggleMV(id) {
  const short = document.getElementById(id + '-short');
  const full  = document.getElementById(id + '-full');
  const btn   = short.closest('.mv-card').querySelector('.mv-expand');
  const isOpen = full.style.display !== 'none';
  full.style.display  = isOpen ? 'none' : 'block';
  short.style.display = isOpen ? 'block' : 'none';
  btn.textContent = isOpen ? 'Leer más ↓' : 'Leer menos ↑';
}
window.toggleMV = toggleMV;
</script>
