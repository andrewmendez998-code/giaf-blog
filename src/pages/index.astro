---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>

<!-- ══ VIDEO INTRO ══ -->
<div id="video-intro">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>
  <svg class="intro-lines" viewBox="0 0 1400 800" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
    <path class="wave-1" d="M-100 650 C200 520, 500 720, 800 600 S1100 450, 1500 560" stroke="#2563eb" stroke-width="3" fill="none" opacity="0.3"/>
    <path class="wave-2" d="M-100 700 C200 570, 500 770, 800 650 S1100 500, 1500 610" stroke="#2563eb" stroke-width="1.5" fill="none" opacity="0.18"/>
    <path class="wave-3" d="M-100 80 C300 180, 600 20, 900 120 S1200 280, 1500 160" stroke="#1a4fa0" stroke-width="2.5" fill="none" opacity="0.25"/>
    <path class="wave-4" d="M-100 40 C300 140, 600 -20, 900 80 S1200 240, 1500 120" stroke="#1a4fa0" stroke-width="1" fill="none" opacity="0.15"/>
  </svg>
  <div class="intro-content">
    <video id="intro-video" muted playsinline preload="auto">
      <source src="/logo-intro.webm" type="video/webm"/>
      <source src="/logo-intro.mp4" type="video/mp4"/>
    </video>
    <p id="intro-skip">Toca para continuar</p>
  </div>
</div>

<!-- ══ HERO ══ -->
<section id="hero-text-section">
  <div class="hero-inner">
    <div class="hero-logo-wrap">
      <img src="/logo-blue.png" alt="GIAF" class="hero-logo-seal"/>
    </div>
    <p class="hero-kicker">Grupo de Investigación en Anatomía Funcional · UANL · 2026</p>
    <h1 class="hero-title">Anatomía Funcional<br/><em>en Movimiento</em></h1>
    <p class="hero-desc">Somos un grupo de investigación integrado por estudiantes de Terapia Física y Readaptación Deportiva de la UANL, dedicados a comprender cómo la estructura y función del cuerpo humano se integran para producir movimiento, favorecer la rehabilitación y optimizar el rendimiento físico.</p>
    <div class="hero-actions">
      <a href="/articulos" class="btn-primary">Explorar Investigación →</a>
      <a href="/involucrate" class="btn-outline">Únete al GIAF</a>
    </div>
    <div class="hero-stats">
      <div class="hstat"><span class="hnum">2</span><span class="hlbl">Facultades</span></div>
      <div class="hstat-div"></div>
      <div class="hstat"><span class="hnum" style="font-size:1.1rem;letter-spacing:.05em;">Pronto</span><span class="hlbl">Líneas de investigación</span></div>
      <div class="hstat-div"></div>
      <div class="hstat"><span class="hnum">2026</span><span class="hlbl">Año de fundación</span></div>
    </div>
  </div>
</section>

<hr class="sep"/>

<!-- ══ MISIÓN / VISIÓN ══ -->
<section id="mision" class="section-light">
  <div class="section-inner">
    <div class="mv-grid reveal">
      <div class="mv-card mv-blue">
        <p class="section-label" style="color:rgba(255,255,255,.5);">Misión</p>
        <h3 class="mv-title">Nuestro Propósito</h3>
        <p class="mv-text mv-short" id="mision-short">Promover el desarrollo académico y científico de la fisioterapia mediante un enfoque anatómico-funcional, fomentando la investigación, la actualización constante y la difusión del conocimiento relacionado con el movimiento humano, la rehabilitación y la prevención de lesiones.</p>
        <p class="mv-text mv-full" id="mision-full" style="display:none;">Promover el desarrollo académico y científico de la fisioterapia mediante un enfoque anatómico-funcional, fomentando la investigación, la actualización constante y la difusión del conocimiento relacionado con el movimiento humano, la rehabilitación y la prevención de lesiones.<br/><br/>El grupo busca concientizar a estudiantes y profesionales del área de la salud sobre la importancia de comprender la función anatómica como base para una intervención fisioterapéutica integral, basada en evidencia y centrada en la educación del paciente, la readaptación funcional y la cultura preventiva.</p>
        <button class="mv-expand" onclick="toggleMV('mision')">Leer más ↓</button>
      </div>
      <div class="mv-card mv-white">
        <p class="section-label">Visión</p>
        <h3 class="mv-title" style="color:var(--navy)">Hacia Dónde Vamos</h3>
        <p class="mv-text mv-short" id="vision-short" style="color:var(--text-2)">Ser el primer grupo estudiantil de investigación reconocido por su innovación académica y su contribución al fortalecimiento de la fisioterapia desde un enfoque anatómico-funcional, promoviendo una visión más amplia de la rehabilitación y la clínica deportiva.</p>
        <p class="mv-text mv-full" id="vision-full" style="display:none;color:var(--text-2)">Ser el primer grupo estudiantil de investigación reconocido por su innovación académica y su contribución al fortalecimiento de la fisioterapia desde un enfoque anatómico-funcional, promoviendo una visión más amplia de la rehabilitación y la clínica deportiva.<br/><br/>Aspiramos a convertirnos en un referente universitario en investigación, difusión científica y educación en movimiento humano, impulsando la formación de profesionales comprometidos en la prevención, el análisis y la atención integral del paciente.</p>
        <button class="mv-expand" style="color:var(--blue);border-color:var(--blue);" onclick="toggleMV('vision')">Leer más ↓</button>
      </div>
    </div>
    <div class="valores-row reveal" style="margin-top:2rem;">
      <span class="valor-chip">Respeto</span>
      <span class="valor-chip">Ética Profesional</span>
      <span class="valor-chip">Trabajo en Equipo</span>
      <span class="valor-chip">Disciplina Académica</span>
      <span class="valor-chip">Actualización Científica</span>
      <span class="valor-chip">Cultura Preventiva</span>
    </div>
  </div>
</section>

<hr class="sep"/>

<!-- ══ ARTÍCULOS COMING SOON ══ -->
<section id="articulo-destacado">
  <div class="section-inner">
    <div class="coming-soon-wrap reveal">
      <p class="section-label">Artículos e Investigaciones</p>
      <div class="coming-soon-card">
        <div class="cs-logo"><img src="/logo-blue.png" alt="GIAF" style="width:64px;height:64px;object-fit:contain;opacity:.4;"/></div>
        <h2 class="cs-title">Próximamente...</h2>
        <p class="cs-text">El GIAF está trabajando en sus primeras publicaciones e investigaciones. Muy pronto encontrarás aquí artículos, revisiones sistemáticas y proyectos del grupo.</p>
        <a href="https://instagram.com/giaf.uanl" target="_blank" class="btn-outline" style="display:inline-block;margin-top:1.5rem;">Síguenos en Instagram para novedades →</a>
      </div>
    </div>
  </div>
</section>

<hr class="sep"/>

<!-- ══ NOTICIAS ══ -->
<section id="noticias" class="section-light">
  <div class="section-inner">
    <div class="news-header reveal">
      <div>
        <p class="section-label">Noticias GIAF</p>
        <h2 class="section-title">Lo Último del Grupo</h2>
      </div>
      <a href="/noticias" class="link-all">Ver todas →</a>
    </div>
    <div class="news-featured reveal" style="margin-bottom:1.5rem;">
      <a href="/noticias" class="news-feat-card">
        <div class="news-feat-img">
          <img src="/equipo.jpg" alt="Equipo GIAF" style="width:100%;height:auto;display:block;"/>
          <div class="news-feat-overlay">
            <span class="news-cat" style="color:white;border-color:rgba(255,255,255,.4);background:rgba(255,255,255,.15)">Comunidad</span>
            <h3 class="news-feat-title">Primera foto oficial del equipo GIAF — Ciclo 2026</h3>
            <p class="news-feat-sub">Los integrantes fundadores reunidos en el campus UANL.</p>
          </div>
        </div>
      </a>
    </div>
    <div class="news-coming reveal">
      <div class="news-cs-card">
        <span style="font-size:2rem;">📢</span>
        <h3 style="font-family:var(--serif);font-size:1.3rem;color:var(--navy);margin:.5rem 0;">Más noticias próximamente</h3>
        <p style="font-size:.85rem;color:var(--muted);">Estamos comenzando. Pronto publicaremos eventos, talleres y actividades del grupo.</p>
      </div>
    </div>
  </div>
</section>

<hr class="sep"/>

<!-- ══ LÍNEAS ══ -->
<section id="lineas">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label">Líneas de Investigación</p>
      <h2 class="section-title">Áreas de Enfoque Científico</h2>
      <p class="section-desc">Tres ejes que articulan anatomía, fisiología y ciencias del movimiento.</p>
    </div>
    <div class="lineas-grid" style="grid-template-columns:repeat(3,1fr);">
      <div class="linea-card reveal reveal-delay-1">
        <div class="linea-num">01</div>
        <h3 class="linea-title">Biomecánica</h3>
        <p class="linea-desc">Análisis del movimiento humano, patrones cinemáticos y cinéticos en contextos deportivos y clínicos.</p>
        <div class="linea-tags"><span class="linea-tag">Cinemática</span><span class="linea-tag">EMG</span><span class="linea-tag">Fuerza</span></div>
      </div>
      <div class="linea-card reveal reveal-delay-2">
        <div class="linea-num">02</div>
        <h3 class="linea-title">Neurociencia</h3>
        <p class="linea-desc">Control motor, propiocepción y estrategias neuromusculares aplicadas a la rehabilitación y el deporte.</p>
        <div class="linea-tags"><span class="linea-tag">Control Motor</span><span class="linea-tag">Propiocepción</span><span class="linea-tag">Reflejos</span></div>
      </div>
      <div class="linea-card reveal reveal-delay-3">
        <div class="linea-num">03</div>
        <h3 class="linea-title">Entrenamiento</h3>
        <p class="linea-desc">Principios del entrenamiento deportivo orientados a la mejora del rendimiento físico y la salud.</p>
        <div class="linea-tags"><span class="linea-tag">Fuerza</span><span class="linea-tag">Resistencia</span><span class="linea-tag">Periodización</span></div>
      </div>
      <div class="linea-card reveal reveal-delay-1">
        <div class="linea-num">04</div>
        <h3 class="linea-title">Readaptación</h3>
        <p class="linea-desc">Procesos de readaptación deportiva post-lesión para el retorno seguro a la actividad física y competitiva.</p>
        <div class="linea-tags"><span class="linea-tag">Return to Sport</span><span class="linea-tag">Rehabilitación</span><span class="linea-tag">Funcional</span></div>
      </div>
      <div class="linea-card reveal reveal-delay-2">
        <div class="linea-num">05</div>
        <h3 class="linea-title">Prevención</h3>
        <p class="linea-desc">Estrategias de prevención de lesiones musculoesqueléticas en poblaciones deportivas y clínicas.</p>
        <div class="linea-tags"><span class="linea-tag">Screening</span><span class="linea-tag">Factores de Riesgo</span><span class="linea-tag">Educación</span></div>
      </div>
      <div class="linea-card reveal reveal-delay-3" style="border-style:dashed;opacity:.7;">
        <div class="linea-num" style="color:var(--border);">+</div>
        <h3 class="linea-title" style="color:var(--muted);">Más por venir</h3>
        <p class="linea-desc">El GIAF continúa expandiendo sus áreas de investigación. Nuevas líneas en desarrollo.</p>
        <div class="linea-tags"><span class="linea-tag">Coming Soon</span></div>
      </div>
    </div>
  </div>
</section>

<hr class="sep"/>

<!-- ══ EQUIPO ══ -->
<section class="section-light">
  <div class="section-inner">
    <div class="reveal" style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2.5rem;flex-wrap:wrap;gap:1rem;">
      <div>
        <p class="section-label">Conócenos</p>
        <h2 class="section-title">El Equipo GIAF</h2>
      </div>
      <a href="/conocenos" class="link-all">Ver equipo completo →</a>
    </div>
    <div class="reveal" style="margin-bottom:2rem;">
      <div class="team-photo-wrap">
        <img src="/equipo.jpg" alt="Equipo GIAF" class="team-photo"/>
        <div class="team-photo-caption">Equipo fundador GIAF · Campus UANL · 2026</div>
      </div>
    </div>
    <div class="team-grid">
      <div class="team-card reveal reveal-delay-1">
        <div class="team-avatar">CG</div>
        <h4 class="team-name">Coordinación General</h4>
        <p class="team-role">Dirección del Grupo</p>
        <p class="team-area">Supervisión de proyectos y representación institucional del GIAF.</p>
      </div>
      <div class="team-card reveal reveal-delay-2">
        <div class="team-avatar">CA</div>
        <h4 class="team-name">Coordinación Académica</h4>
        <p class="team-role">Desarrollo Formativo</p>
        <p class="team-area">Organización de sesiones académicas, talleres y actualización científica.</p>
      </div>
      <div class="team-card reveal reveal-delay-3">
        <div class="team-avatar">CM</div>
        <h4 class="team-name">Coordinación de Medios</h4>
        <p class="team-role">Comunicación y Difusión</p>
        <p class="team-area">Identidad visual, redes sociales y difusión del contenido académico.</p>
      </div>
      <div class="team-card reveal reveal-delay-1">
        <div class="team-avatar">+</div>
        <h4 class="team-name">¿Te unes?</h4>
        <p class="team-role">Próximo Integrante</p>
        <p class="team-area">Buscamos estudiantes de LTFyRD y Medicina con pasión por la investigación.</p>
      </div>
    </div>
  </div>
</section>

<hr class="sep"/>

<!-- ══ CTA ══ -->
<section>
  <div class="section-inner">
    <div class="cta-banner reveal">
      <p class="section-label" style="justify-content:center;color:rgba(255,255,255,.5);">Involúcrate</p>
      <h2 class="cta-title">Forma Parte de la<br/><em style="font-style:italic;color:var(--blue-pale)">Comunidad GIAF</em></h2>
      <p class="cta-subtitle">Abierto a estudiantes de FOD y Medicina UANL. Si te interesa la investigación en anatomía funcional, este es tu espacio.</p>
      <div class="cta-actions">
        <a href="mailto:giaf@uanl.mx" class="btn-primary btn-white">Contáctanos →</a>
        <a href="https://instagram.com/giaf.uanl" target="_blank" class="btn-outline" style="border-color:rgba(255,255,255,.25);color:rgba(255,255,255,.8);display:inline-flex;align-items:center;gap:.5rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          @giaf.uanl
        </a>
      </div>
      <div class="cta-divider"><span>O SUSCRÍBETE AL BOLETÍN</span></div>
      <div class="cta-form">
        <input class="cta-input" type="email" placeholder="tucorreo@uanl.edu.mx"/>
        <a href="#" class="btn-primary">Suscribir</a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* ── VIDEO INTRO ── */
#video-intro {
  position: fixed; inset: 0; z-index: 9999;
  background: #ffffff;
  display: flex; align-items: center; justify-content: center;
  flex-direction: column;
  transition: opacity .8s ease;
  overflow: hidden;
}
#video-intro.hidden { opacity: 0; pointer-events: none; }

/* Animated blobs */
.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  pointer-events: none;
}
.blob-1 {
  width: 400px; height: 400px;
  background: rgba(37,99,235,0.12);
  top: -100px; left: -100px;
  animation: blobMove1 8s ease-in-out infinite;
}
.blob-2 {
  width: 350px; height: 350px;
  background: rgba(37,99,235,0.09);
  bottom: -80px; right: -80px;
  animation: blobMove2 10s ease-in-out infinite;
}
.blob-3 {
  width: 250px; height: 250px;
  background: rgba(26,79,160,0.07);
  top: 40%; left: -60px;
  animation: blobMove3 12s ease-in-out infinite;
}
@keyframes blobMove1 {
  0%,100% { transform: translate(0,0) scale(1); }
  50% { transform: translate(60px,40px) scale(1.1); }
}
@keyframes blobMove2 {
  0%,100% { transform: translate(0,0) scale(1); }
  50% { transform: translate(-50px,-30px) scale(1.08); }
}
@keyframes blobMove3 {
  0%,100% { transform: translate(0,0); }
  50% { transform: translate(30px,-50px); }
}

/* Animated SVG waves */
.intro-lines {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  pointer-events: none;
}
.wave-1 { animation: waveDrift 6s ease-in-out infinite; }
.wave-2 { animation: waveDrift 8s ease-in-out infinite reverse; }
.wave-3 { animation: waveDrift 7s ease-in-out infinite 1s; }
.wave-4 { animation: waveDrift 9s ease-in-out infinite reverse 0.5s; }
@keyframes waveDrift {
  0%,100% { transform: translateX(0); }
  50% { transform: translateX(-40px); }
}

.intro-content {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center;
}
#intro-video {
  width: min(92vw, 820px);
  height: auto; display: block;
}
#intro-skip {
  margin-top: 1.5rem;
  font-family: 'Space Mono', monospace;
  font-size: .65rem; letter-spacing: .2em;
  color: rgba(0,0,0,.28);
  text-transform: uppercase; cursor: pointer;
  animation: blink 2s ease infinite;
}
@keyframes blink { 0%,100%{opacity:.28} 50%{opacity:.65} }

/* ── HERO ── */
#hero-text-section {
  background: var(--white);
  border-bottom: 1px solid var(--border-lt);
  padding: 9rem 0 7rem;
  text-align: center;
  position: relative;
}
.hero-inner { max-width: 860px; margin: 0 auto; padding: 0 3rem; }

.hero-logo-wrap { margin-bottom: 2.5rem; }
.hero-logo-seal {
  width: 120px; height: 120px;
  object-fit: contain;
  display: block; margin: 0 auto;
}

.hero-kicker {
  font-family: 'Space Mono', monospace;
  font-size: .68rem; letter-spacing: .2em; color: var(--blue);
  text-transform: uppercase; margin-bottom: 2rem;
  display: flex; align-items: center; justify-content: center; gap: .8rem;
}
.hero-kicker::before,
.hero-kicker::after { content:''; width:24px; height:1px; background:var(--blue); }

.hero-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(3.8rem, 8vw, 6.5rem); font-weight: 600;
  line-height: 1.02; color: var(--navy); margin-bottom: 1.75rem;
  letter-spacing: -0.01em;
}
.hero-title em { font-style: italic; color: var(--blue); }

.hero-desc {
  font-size: 1.05rem; color: var(--muted); line-height: 1.85;
  max-width: 580px; margin: 0 auto 3rem;
}
.hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-bottom: 4rem; }
.hero-stats {
  display: flex; align-items: center; justify-content: center;
  gap: 2.5rem; flex-wrap: wrap;
  padding-top: 3rem; border-top: 1px solid var(--border-lt);
}
.hstat { display: flex; flex-direction: column; align-items: center; gap: .3rem; }
.hnum { font-family: 'Cormorant Garamond', serif; font-size: 2.5rem; font-weight: 700; color: var(--blue); line-height: 1; }
.hlbl { font-size: .65rem; color: var(--muted); text-transform: uppercase; letter-spacing: .12em; }
.hstat-div { width: 1px; height: 44px; background: var(--border-lt); }

/* ── MISIÓN VISIÓN ── */
.section-light { background: var(--offwhite); }
.mv-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
.mv-card { border-radius:12px; padding:2.5rem; }
.mv-blue { background:var(--navy); }
.mv-white { background:var(--white); border:1px solid var(--border-lt); }
.mv-title { font-family:'Cormorant Garamond',serif; font-size:1.6rem; font-weight:600; color:var(--white); margin-bottom:.75rem; }
.mv-text  { font-size:.88rem; color:rgba(255,255,255,.65); line-height:1.85; }
.valores-row { display:flex; flex-wrap:wrap; gap:.6rem; }
.valor-chip { font-family:'Space Mono',monospace; font-size:.6rem; letter-spacing:.1em; color:var(--blue); background:var(--white); border:1px solid var(--blue); padding:.3rem .8rem; border-radius:99px; }

/* ── NEWS ── */
.news-feat-card { display:block; border-radius:12px; overflow:hidden; text-decoration:none; }
.news-feat-img { position:relative; height:auto; background:var(--navy); overflow:hidden; }
.news-feat-img img { display:block; width:100%; height:auto; }
.news-feat-overlay { position:absolute; inset:0; background:linear-gradient(to top, rgba(12,31,63,0.92) 0%, rgba(12,31,63,0.3) 60%, transparent 100%); padding:2rem; display:flex; flex-direction:column; justify-content:flex-end; gap:.5rem; }
.news-feat-title { font-family:'Cormorant Garamond',serif; font-size:1.7rem; font-weight:600; color:#fff; line-height:1.2; }
.news-feat-sub   { font-size:.82rem; color:rgba(255,255,255,.7); }

/* ── TEAM PHOTO ── */
.team-photo-wrap { border-radius:12px; overflow:hidden; position:relative; }
.team-photo { width:100%; height:460px; object-fit:cover; object-position:center 25%; display:block; }
.team-photo-caption { position:absolute; bottom:0; left:0; right:0; background:linear-gradient(transparent, rgba(12,31,63,0.85)); color:rgba(255,255,255,.8); font-family:'Space Mono',monospace; font-size:.6rem; letter-spacing:.15em; text-align:center; padding:2rem 1rem .75rem; text-transform:uppercase; }

/* ── RESPONSIVE ── */
