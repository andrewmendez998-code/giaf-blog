<script>
(function () {
  const overlay = document.getElementById('video-intro');
  const video   = document.getElementById('intro-video');
  const canvas  = document.getElementById('intro-canvas');
  if (!overlay || !video || !canvas) return;

  const ctx = canvas.getContext('2d', { willReadFrequently: true });
  canvas.width  = 860;
  canvas.height = 860;

  let rafId = null;
  let started = false;

  function drawFrame() {
    if (video.paused || video.ended) return;
    ctx.clearRect(0, 0, 860, 860);
    ctx.drawImage(video, 0, 0, 860, 860);
    const imageData = ctx.getImageData(0, 0, 860, 860);
    const data = imageData.data;
    for (let i = 0; i < data.length; i += 4) {
      if (data[i] > 240 && data[i+1] > 240 && data[i+2] > 240) {
        data[i+3] = 0;
      }
    }
    ctx.putImageData(imageData, 0, 0);
    rafId = requestAnimationFrame(drawFrame);
  }

  function hideIntro() {
    if (overlay.dataset.hidden) return;
    overlay.dataset.hidden = '1';
    if (rafId) cancelAnimationFrame(rafId);
    overlay.classList.add('is-hiding');
    setTimeout(() => overlay.remove(), 750);
  }

  function showSkipPrompt() {
    const skip = document.getElementById('intro-skip');
    if (skip) {
      skip.textContent = '▶ Toca para comenzar';
      skip.style.opacity = '1';
      skip.style.animation = 'none';
    }
  }

  function tryPlay() {
    if (started) return;
    started = true;
    const p = video.play();
    if (p && typeof p.then === 'function') {
      p.then(() => drawFrame()).catch(() => {
        started = false;
        showSkipPrompt();
      });
    } else {
      drawFrame();
    }
  }

  // Si el video ya tiene datos suficientes (cache del browser), arranca de inmediato
  if (video.readyState >= 3) {
    tryPlay();
  } else {
    // Intentar en canplay Y en loadeddata para agarrar el que llegue primero
    video.addEventListener('canplay',   tryPlay, { once: true });
    video.addEventListener('loadeddata', tryPlay, { once: true });
  }

  video.addEventListener('ended', hideIntro, { once: true });
  overlay.addEventListener('click', () => { video.pause(); hideIntro(); });
  video.addEventListener('error', () => setTimeout(hideIntro, 2000), { once: true });

  // Si en 5s no arrancó, mostrar prompt de tap
  const stallTimer = setTimeout(() => {
    if (!started) showSkipPrompt();
  }, 5000);
  video.addEventListener('canplay', () => clearTimeout(stallTimer), { once: true });

  // Al hacer tap/click cuando el video no ha arrancado aún, intentar play
  overlay.addEventListener('click', () => {
    if (!started) tryPlay();
  });
})();

/* ── Mission / Vision expand (uses data-target, no global fn needed) ── */
document.querySelectorAll('.mv-expand').forEach(btn => {
  btn.addEventListener('click', () => {
    const id    = btn.dataset.target;
    const short = document.getElementById(id + '-short');
    const full  = document.getElementById(id + '-full');
    if (!short || !full) return;
    const isOpen = !full.hidden;
    full.hidden  = isOpen;
    short.hidden = !isOpen;
    btn.textContent = isOpen ? 'Leer más ↓' : 'Leer menos ↑';
  });
});

/* ── Carrusel destacado (Lo Último del Grupo) ── */
(function () {
  const carousel = document.getElementById('homeIgCarousel');
  if (!carousel) return;

  const track    = carousel.querySelector('.ig-track');
  const frame    = carousel.querySelector('.ig-frame');
  const slides   = Array.from(carousel.querySelectorAll('.ig-slide'));
  const dots     = Array.from(carousel.querySelectorAll('.ig-dot'));
  const prevBtn  = carousel.querySelector('.ig-prev');
  const nextBtn  = carousel.querySelector('.ig-next');
  const progress = carousel.querySelector('.ig-progress-bar');
  const counter  = document.getElementById('homeIgCounter');
  const captionWrap = document.getElementById('homeIgCaptionText');
  const glow     = carousel.querySelector('.ig-glow');
  const dotgrid  = carousel.querySelector('.ig-dotgrid');

  const data = [
    { title: "Así arrancó el módulo", text: "Paolo Cano impartió la primera capacitación del programa: un recorrido por todo el proceso de investigación, pensado para que dejara de sentirse como una materia más." },
    { title: "El método científico, en 5 pasos", text: "De la observación a la difusión: observación y problema, pregunta de investigación con PICO, hipótesis y diseño, recolección y análisis, y difusión científica." },
    { title: "La estrategia PICO", text: "Toda buena pregunta de investigación se puede romper en cuatro piezas: a quién estudias, qué evalúas, contra qué lo comparas y qué resultado mides." },
    { title: "El cierre: el lugar de la IA", text: "La sesión cerró con una idea clara: la IA puede ayudarte a buscar y a redactar, pero nunca a diseñar tu metodología ni a interpretar tus resultados." },
  ];

  const total = slides.length;
  let index = 0;
  let timer = null;

  function render(direction) {
    track.style.transform = `translateX(-${index * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === index));

    const n = String(index + 1).padStart(2, '0');
    const t = String(total).padStart(2, '0');
    if (counter) counter.innerHTML = `<b>${n}</b> / ${t}`;
    if (progress) progress.style.width = `${((index + 1) / total) * 100}%`;

    if (captionWrap) {
      const dir = direction || 1;
      const outClass = dir < 0 ? 'ig-out-right' : 'ig-out-left';
      const inClass  = dir < 0 ? 'ig-in-right'  : 'ig-in-left';
      captionWrap.className = `ig-caption-text ${outClass}`;
      setTimeout(() => {
        const d = data[index];
        captionWrap.innerHTML = `<p class="ig-caption-title">${d.title}</p><p class="ig-caption-desc">${d.text}</p>`;
        captionWrap.className = `ig-caption-text ${inClass}`;
      }, 200);
    }

    if (glow) {
      const positions = ['28% 30%', '70% 25%', '50% 60%', '30% 65%'];
      glow.style.background = `radial-gradient(circle at ${positions[index]}, var(--blue-pale) 0%, transparent 62%)`;
    }
  }

  function goTo(i, userInitiated) {
    const prevIndex = index;
    index = ((i % total) + total) % total;
    let direction = 1;
    if (prevIndex === total - 1 && index === 0) direction = 1;
    else if (prevIndex === 0 && index === total - 1) direction = -1;
    else direction = index >= prevIndex ? 1 : -1;
    render(direction);
    if (userInitiated) restart();
  }

  function restart() {
    if (timer) clearInterval(timer);
    timer = setInterval(() => goTo(index + 1, false), 5000);
  }

  nextBtn?.addEventListener('click', (e) => { e.preventDefault(); goTo(index + 1, true); });
  prevBtn?.addEventListener('click', (e) => { e.preventDefault(); goTo(index - 1, true); });
  dots.forEach((d, i) => d.addEventListener('click', () => goTo(i, true)));

  /* Pausa el autoplay mientras el cursor está sobre el carrusel; se reanuda al salir */
  carousel.addEventListener('mouseenter', () => { if (timer) clearInterval(timer); });
  carousel.addEventListener('mouseleave', () => { resetParallax(); restart(); });

  /* Parallax sutil sobre la imagen activa y el patrón de puntos */
  function resetParallax() {
    const img = slides[index]?.querySelector('img');
    if (img) img.style.transform = '';
    if (dotgrid) dotgrid.style.transform = '';
  }

  frame?.addEventListener('mousemove', (e) => {
    const rect = frame.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width - 0.5;
    const y = (e.clientY - rect.top) / rect.height - 0.5;
    const img = slides[index]?.querySelector('img');
    if (img) img.style.transform = `scale(1.012) translate3d(${x * -6}px, ${y * -4}px, 0)`;
    if (dotgrid) dotgrid.style.transform = `translate3d(${x * 8}px, ${y * 6}px, 0)`;
  });

  render();
  restart();
})();
</script>