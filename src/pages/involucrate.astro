---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Involúcrate · GIAF UANL">

  <section style="padding: 8rem 0 4rem; background: var(--bg2); border-bottom: 1px solid var(--border2);">
    <div class="section-inner">
      <p class="section-label">Involúcrate</p>
      <h1 class="section-title">Forma Parte del GIAF</h1>
      <p class="section-desc">Abierto a estudiantes de licenciatura y posgrado de FOD y Medicina UANL con interés en la investigación científica.</p>
    </div>
  </section>

  <section>
    <div class="section-inner" style="max-width:760px;">

      <!-- Opciones -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; margin-bottom:4rem;">
        <div class="linea-card reveal reveal-delay-1">
          <div class="linea-num">01</div>
          <h3 class="linea-title">Estudiante Colaborador</h3>
          <p class="linea-desc">Participa en proyectos activos del grupo. Ideal para estudiantes de semestrales avanzados que quieran experiencia en investigación.</p>
        </div>
        <div class="linea-card reveal reveal-delay-2">
          <div class="linea-num">02</div>
          <h3 class="linea-title">Tesis e Investigación</h3>
          <p class="linea-desc">Desarrolla tu tesis de licenciatura o posgrado dentro del GIAF con asesoría de nuestros investigadores.</p>
        </div>
        <div class="linea-card reveal reveal-delay-1">
          <div class="linea-num">03</div>
          <h3 class="linea-title">Servicio Social</h3>
          <p class="linea-desc">Cumple tu servicio social apoyando proyectos de investigación en biomecánica, morfología o educación en salud.</p>
        </div>
        <div class="linea-card reveal reveal-delay-2">
          <div class="linea-num">04</div>
          <h3 class="linea-title">Colaboración Externa</h3>
          <p class="linea-desc">Para investigadores de otras instituciones interesados en proyectos conjuntos o intercambio académico.</p>
        </div>
      </div>

      <!-- Contacto -->
      <div class="cta-banner reveal">
        <p class="section-label" style="justify-content:center;">Contacto Directo</p>
        <h2 class="cta-title" style="font-size:2rem;">¿Listo para sumarte?</h2>
        <p class="cta-subtitle">Escríbenos indicando tu nombre, carrera, semestre y área de interés.</p>
        <div class="cta-actions">
          <a href="mailto:giaf@uanl.mx" class="btn-primary">giaf@uanl.mx →</a>
        </div>
        <div class="cta-divider"><span>O SUSCRÍBETE AL BOLETÍN</span></div>
        <div class="cta-form">
          <input class="cta-input" type="email" placeholder="tucorreo@uanl.edu.mx" />
          <a href="#" class="btn-primary" style="white-space:nowrap; padding:.75rem 1.25rem;">Suscribir</a>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
