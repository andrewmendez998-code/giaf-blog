</style>

<script>
  (function () {
    const carousel = document.getElementById('igCarousel');
    if (!carousel) return;

    const track    = carousel.querySelector('.ig-track');
    const frame    = carousel.querySelector('.ig-frame');
    const slides   = Array.from(carousel.querySelectorAll('.ig-slide'));
    const dots     = Array.from(carousel.querySelectorAll('.ig-dot'));
    const prevBtn  = carousel.querySelector('.ig-prev');
    const nextBtn  = carousel.querySelector('.ig-next');
    const progress = carousel.querySelector('.ig-progress-bar');
    const counter  = document.getElementById('igCounter');
    const captionWrap = document.getElementById('igCaptionText');
    const hint     = document.getElementById('igHint');
    const glow     = carousel.querySelector('.ig-glow');
    const dotgrid  = carousel.querySelector('.ig-dotgrid');

    const data = [
      { title: "Así arrancó el módulo", text: "Paolo Cano impartió la primera capacitación del programa: un recorrido por todo el proceso de investigación, pensado para que dejara de sentirse como una materia más." },
      { title: "El método científico, en 5 pasos", text: "De la observación a la difusión: observación y problema, pregunta de investigación con PICO, hipótesis y diseño, recolección y análisis, y difusión científica." },
      { title: "La estrategia PICO", text: "Toda buena pregunta de investigación se puede romper en cuatro piezas: a quién estudias, qué evalúas, contra qué lo comparas y qué resultado mides." },
      { title: "El cierre: el lugar de la IA", text: "La sesión cerró con una idea clara: la IA puede ayudarte a buscar y a redactar, pero nunca a diseñar tu metodología ni a interpretar tus resultados." },
    ];

    const total = slides.length;
    let index = 0;
    let timer = null;
    let hintHidden = false;

    function hideHint() {
      if (hintHidden) return;
      hintHidden = true;
      hint?.classList.add('is-hidden');
    }

    function render(direction) {
      track.style.transform = `translateX(-${index * 100}%)`;

      dots.forEach((d, i) => d.classList.toggle('active', i === index));

      const n = String(index + 1).padStart(2, '0');
      const t = String(total).padStart(2, '0');
      if (counter) counter.innerHTML = `<b>${n}</b> / ${t}`;

      if (progress) progress.style.width = `${((index + 1) / total) * 100}%`;

      if (captionWrap) {
        const dir = direction || 1;
        const outClass = dir < 0 ? 'ig-out-right' : 'ig-out-left';
        const inClass  = dir < 0 ? 'ig-in-right'  : 'ig-in-left';
        captionWrap.className = `ig-caption-text ${outClass}`;
        setTimeout(() => {
          const d = data[index];
          captionWrap.innerHTML = `<p class="ig-caption-title">${d.title}</p><p class="ig-caption-desc">${d.text}</p>`;
          captionWrap.className = `ig-caption-text ${inClass}`;
        }, 200);
      }

      if (glow) {
        const positions = ['28% 30%', '70% 25%', '50% 60%', '30% 65%'];
        glow.style.background = `radial-gradient(circle at ${positions[index]}, var(--blue-pale) 0%, transparent 62%)`;
      }
    }

    function goTo(i, userInitiated) {
      const prevIndex = index;
      index = ((i % total) + total) % total;
      let direction = 1;
      if (prevIndex === total - 1 && index === 0) direction = 1;       // next, wrap to start
      else if (prevIndex === 0 && index === total - 1) direction = -1; // prev, wrap to end
      else direction = index >= prevIndex ? 1 : -1;
      render(direction);
      if (userInitiated) {
        hideHint();
        restart();
      }
    }

    function restart() {
      if (timer) clearInterval(timer);
      timer = setInterval(() => goTo(index + 1, false), 6500);
    }

    nextBtn?.addEventListener('click', () => goTo(index + 1, true));
    prevBtn?.addEventListener('click', () => goTo(index - 1, true));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i, true)));

    /* Pausa el autoplay mientras el cursor está sobre el carrusel */
    carousel.addEventListener('mouseenter', () => { if (timer) clearInterval(timer); });
    carousel.addEventListener('mouseleave', () => { restart(); resetParallax(); });

    /* Parallax sutil sobre la imagen activa y el patrón de puntos */
    function resetParallax() {
      const img = slides[index]?.querySelector('img');
      if (img) img.style.transform = '';
      if (dotgrid) dotgrid.style.transform = '';
    }

    frame?.addEventListener('mousemove', (e) => {
      const rect = frame.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      const img = slides[index]?.querySelector('img');
      if (img) img.style.transform = `scale(1.012) translate3d(${x * -6}px, ${y * -4}px, 0)`;
      if (dotgrid) dotgrid.style.transform = `translate3d(${x * 8}px, ${y * 6}px, 0)`;
    });
    frame?.addEventListener('mouseleave', resetParallax);

    /* Soporte táctil: deslizar para cambiar de diapositiva */
    let touchStartX = 0;
    frame?.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    frame?.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) {
        goTo(index + (dx < 0 ? 1 : -1), true);
      }
    }, { passive: true });

    /* Navegación con teclado cuando el carrusel tiene foco */
    carousel.setAttribute('tabindex', '0');
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') goTo(index + 1, true);
      if (e.key === 'ArrowLeft') goTo(index - 1, true);
    });

    render();
    restart();
  })();
</script>