  }

  @media (max-width: 640px) {
    .ia-box { grid-template-columns: 1fr; }
  }

  /* ───────── BANNER INSTAGRAM ───────── */
  .noticias-ig-banner {
    display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;
    background: var(--navy);
    border-radius: 14px;
    padding: 2rem 2.5rem;
    color: white;
  }
  .ig-banner-icon { color: rgba(255,255,255,.7); flex-shrink: 0; }
  .ig-banner-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem; font-weight: 600; margin-bottom: .25rem;
  }
  .ig-banner-sub { font-size: .84rem; color: rgba(255,255,255,.6); }
  .ig-banner-btn { margin-left: auto; white-space: nowrap; }

  @media (max-width: 600px) {
    .noticias-ig-banner { flex-direction: column; align-items: flex-start; padding: 1.5rem; }
    .ig-banner-btn { margin-left: 0; width: 100%; text-align: center; }
