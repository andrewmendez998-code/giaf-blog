    </div>
  </div>

</BaseLayout>

<style>
  /* ───────── CONTENEDOR ANCHO (rompe el ancho de columna, edge-to-edge) ───────── */
  .ig-wide-wrap {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 0 1.25rem;
  }

  /* ───────── CARRUSEL ───────── */
  .ig-carousel {
    position: relative;
    isolation: isolate;
  }

  .ig-glow {
    position: absolute;
    inset: -10% -6%;
    z-index: -1;
    border-radius: 32px;
    background: radial-gradient(circle at 28% 30%, var(--blue-pale) 0%, transparent 62%);
    filter: blur(36px);
    opacity: .8;
    transition: background 0.7s ease;
    pointer-events: none;
  }

  .ig-dotgrid {
    position: absolute;
    top: -18px; right: -18px;
    width: 110px; height: 110px;
    z-index: -1;
    pointer-events: none;
    opacity: .35;
    background-image: radial-gradient(var(--blue-lt) 1.5px, transparent 1.5px);
    background-size: 14px 14px;
    transition: transform .6s cubic-bezier(.4,0,.2,1);
  }

  .ig-frame {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    aspect-ratio: 1400 / 787;
    background: var(--navy);
    box-shadow: 0 30px 80px -16px rgba(12,31,63,.28);
    border: 1px solid var(--border-lt);
  }

  .ig-progress {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: rgba(255,255,255,.18);
    z-index: 6;
  }
  .ig-progress-bar {
    display: block;
    height: 100%;
    width: 25%;
    background: linear-gradient(90deg, var(--blue-lt), var(--blue));
    transition: width .65s cubic-bezier(.4,0,.2,1);
  }

  .ig-track {
    display: flex;
    height: 100%;
    transition: transform .65s cubic-bezier(.4,0,.2,1);
    will-change: transform;
  }

  .ig-slide {
    flex: 0 0 100%;
    height: 100%;
    overflow: hidden;
  }
  .ig-slide img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.001) translate3d(0,0,0);
    transition: transform .5s cubic-bezier(.2,.6,.3,1);
    will-change: transform;
  }

  .ig-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 54px; height: 54px;
    border-radius: 50%;
    border: 1px solid var(--border-lt);
    background: rgba(255,255,255,.92);
    color: var(--navy);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(4px);
    box-shadow: 0 6px 20px rgba(12,31,63,.18);
    transition: background .2s, color .2s, transform .2s, box-shadow .2s;
    z-index: 6;
  }
  .ig-arrow svg { width: 22px; height: 22px; }
  .ig-arrow:hover {
    background: var(--blue);
    color: #fff;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 8px 24px rgba(26,79,160,.35);
  }
  .ig-arrow:active { transform: translateY(-50%) scale(.96); }
  .ig-prev { left: 20px; }
  .ig-next { right: 20px; }

  .ig-hint {
    position: absolute;
    right: 22px; bottom: 22px;
    display: flex; align-items: center; gap: .4rem;
    font-family: var(--mono); font-size: .68rem; letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--navy);
    background: rgba(255,255,255,.9);
    padding: .55rem .95rem;
    border-radius: 99px;
    box-shadow: 0 6px 18px rgba(12,31,63,.16);
    z-index: 6;
    opacity: 1;
    transform: translateX(0);
    transition: opacity .5s ease, transform .5s ease;
    pointer-events: none;
  }
  .ig-hint.is-hidden { opacity: 0; transform: translateX(8px); }
  .ig-hint svg { animation: ig-hint-move 1.6s ease-in-out infinite; }

  @keyframes ig-hint-move {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(4px); }
  }

  .ig-caption {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 1.75rem;
  }
  .ig-counter {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.6rem;
    letter-spacing: .02em;
    color: var(--blue-pale);
    padding-top: 0;
    white-space: nowrap;
    line-height: 1;
    transition: color .3s ease;
  }
  .ig-counter b { color: var(--blue); font-size: 1.6rem; }
  .ig-caption-text {
    overflow: hidden;
  }
  .ig-caption-text.ig-out-left  { animation: ig-out-left .22s ease forwards; }
  .ig-caption-text.ig-out-right { animation: ig-out-right .22s ease forwards; }
  .ig-caption-text.ig-in-left   { animation: ig-in-left .4s cubic-bezier(.22,.61,.36,1) forwards; }
  .ig-caption-text.ig-in-right  { animation: ig-in-right .4s cubic-bezier(.22,.61,.36,1) forwards; }

  @keyframes ig-out-left  { to { opacity: 0; transform: translateX(-26px); } }
  @keyframes ig-out-right { to { opacity: 0; transform: translateX(26px); } }
  @keyframes ig-in-left   { from { opacity: 0; transform: translateX(26px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes ig-in-right  { from { opacity: 0; transform: translateX(-26px); } to { opacity: 1; transform: translateX(0); } }

  .ig-caption-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.45rem;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: .4rem;
    display: inline-block;
    position: relative;
    transition: color .25s ease;
    cursor: default;
  }
  .ig-caption-title::after {
    content: '';
    position: absolute;
    left: 0; bottom: -3px;
    width: 0; height: 2px;
    background: var(--blue-lt);
    transition: width .35s cubic-bezier(.22,.61,.36,1);
  }
  .ig-caption-title:hover {
    color: var(--blue);
  }
  .ig-caption-title:hover::after {
    width: 100%;
  }
  .ig-caption-desc {
    font-size: .92rem;
    color: var(--muted);
    line-height: 1.75;
    max-width: 560px;
  }

  .ig-dots {
    display: flex;
    gap: .55rem;
    padding-top: .55rem;
  }
  .ig-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    border: none;
    background: var(--border);
    cursor: pointer;
    padding: 0;
    transition: background .25s, transform .25s, width .25s;
  }
  .ig-dot:hover { background: var(--blue-lt); }
  .ig-dot.active {
    background: var(--blue);
    width: 26px;
    border-radius: 99px;
  }

  @media (max-width: 640px) {
    .ig-caption {
      grid-template-columns: 1fr;
      gap: .75rem;
    }
    .ig-counter { font-size: 1.2rem; }
    .ig-caption-title { font-size: 1.15rem; }
    .ig-caption-desc { font-size: .85rem; max-width: 100%; }
    .ig-dots { order: -1; }
    .ig-arrow { width: 40px; height: 40px; }
    .ig-arrow svg { width: 18px; height: 18px; }
    .ig-prev { left: 10px; }
    .ig-next { right: 10px; }
    .ig-hint { font-size: .58rem; padding: .4rem .7rem; right: 10px; bottom: 10px; }
    .ig-dotgrid { display: none; }
  }
  @media (max-width: 480px) {
    .ig-wide-wrap { padding: 0 .75rem; }
    .ig-frame { border-radius: 14px; }
    .ig-arrow { width: 34px; height: 34px; }
    .ig-arrow svg { width: 15px; height: 15px; }
    .ig-progress { height: 3px; }
    .ig-caption { margin-top: 1rem; }
  }

  /* ───────── BOX IA ───────── */
  .ia-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin: 2rem 0;
  }
  .ia-col {
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-lt);
  }
  .ia-col-yes { border-left: 3px solid #2f9e5b; background: rgba(47,158,91,.05); }
  .ia-col-no  { border-left: 3px solid #d9534f; background: rgba(217,83,79,.05); }
  .ia-col-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: .95rem;
    margin-bottom: .6rem;
    color: var(--navy);
  }
  .ia-col ul { list-style: none; padding-left: 0; margin-bottom: 0; }
  .ia-col li {
    font-size: .82rem;
    color: var(--text-2);
    line-height: 1.7;
    padding-left: 1.1rem;
