---
import BaseLayout from '../../layouts/BaseLayout.astro';

const proyectos = [
  {
    id: 'puncion-seca-analgesia',
    titulo: 'Analgesia por Punción Seca en Patologías Agudas y Crónicas',
    categoria: 'Fisioterapia Clínica',
    tipo: 'Proyecto en Proceso',
    descripcion: 'Evaluación del efecto analgésico de la punción seca en condiciones musculoesqueléticas de presentación aguda y crónica. El proyecto analiza los mecanismos neurofisiológicos implicados y la respuesta clínica en distintas poblaciones.',
    tags: ['Punción Seca', 'Dolor', 'Neurofisiología'],
    emoji: '🩺',
    estado: 'En proceso',
  },
  {
    id: 'agentes-fisicos-ejercicio',
    titulo: 'RS Agentes Físicos y Tratamiento Pasivo vs. Ejercicio Terapéutico',
    categoria: 'Revisión Sistemática',
    tipo: 'Proyecto en Proceso',
    descripcion: 'Revisión sistemática que examina la evidencia comparativa entre el uso de agentes físicos y tratamiento pasivo frente al ejercicio terapéutico activo dentro de los procesos de rehabilitación musculoesquelética.',
    tags: ['Agentes Físicos', 'Ejercicio Terapéutico', 'Evidencia'],
    emoji: '⚡',
    estado: 'En proceso',
  },
  {
    id: 'postura-cervical-esports',
    titulo: 'Relación Anatómica entre Postura Cervical y Compresión Neurovascular en Esports',
    categoria: 'Neuroanatomía Aplicada',
    tipo: 'Proyecto en Proceso',
    descripcion: 'Análisis de la relación entre la postura cervical característica adoptada durante la práctica competitiva de Esports y la presencia de compresión neurovascular, con enfoque en estructuras anatómicas de la región cervical y torácica superior.',
    tags: ['Cervical', 'Esports', 'Compresión Neurovascular'],
    emoji: '🖥️',
    estado: 'En proceso',
  },
];
---

<BaseLayout title="Proyectos · GIAF UANL">

  <section style="padding: 8rem 0 4rem; background: var(--bg2); border-bottom: 1px solid var(--border2);">
    <div class="section-inner">
      <p class="section-label">Publicaciones y Proyectos</p>
      <h1 class="section-title">Artículos e Investigaciones</h1>
      <p class="section-desc">Producción científica activa del Grupo de Investigación en Anatomía Funcional · UANL. Los proyectos listados se encuentran actualmente en desarrollo.</p>
    </div>
  </section>

  <section>
    <div class="section-inner">

      <div class="art-status-banner reveal">
        <span class="art-status-dot"></span>
        <p>Los tres proyectos del GIAF están <strong>en proceso</strong>. Los resultados y publicaciones derivadas estarán disponibles aquí una vez concluidos.</p>
      </div>

      <div style="display:grid; gap:1.5rem; margin-top:2rem;">
        {proyectos.map((p, i) => (
          <article class={`art-card reveal reveal-delay-${i + 1}`}>
            <div class="art-card-icon">{p.emoji}</div>
            <div class="art-card-body">
              <div class="art-card-meta">
                <span class="news-cat">{p.categoria}</span>
                <span class="art-badge-proceso">{p.tipo}</span>
              </div>
              <h2 class="art-card-title">{p.titulo}</h2>
              <p class="art-card-desc">{p.descripcion}</p>
              <div class="art-card-foot">
                <div class="art-tags">
                  {p.tags.map(t => <span class="linea-tag">{t}</span>)}
                </div>
                <div class="art-card-right">
                  <span class="art-en-proceso">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                      <circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M5 2.5V5L6.5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    En proceso · Más información próximamente
                  </span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="art-nota reveal">
        <p>¿Eres estudiante o investigador interesado en colaborar? <a href="/involucrate" class="art-nota-link">Contáctanos →</a></p>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
.art-status-banner {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  border-radius: 10px;
  padding: 1rem 1.5rem;
  font-size: .88rem;
  color: #1e40af;
  margin-top: 3rem;
}
.art-status-dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: #2563eb;
  flex-shrink: 0;
  animation: pulse 2s ease infinite;
}
@keyframes pulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50%      { opacity: .5; transform: scale(1.3); }
}
.art-card {
  display: grid;
  grid-template-columns: 72px 1fr;
  border: 1px solid var(--border-lt);
  border-radius: 12px;
  overflow: hidden;
  background: var(--white);
  transition: box-shadow .2s ease, transform .2s ease;
}
.art-card:hover {
  box-shadow: 0 8px 32px rgba(37,99,235,.1);
  transform: translateY(-2px);
}
.art-card-icon {
  display: flex; align-items: center; justify-content: center;
  font-size: 2rem;
  background: #eff6ff;
  border-right: 1px solid var(--border-lt);
}
.art-card-body {
  padding: 1.5rem;
  display: flex; flex-direction: column; gap: .6rem;
}
.art-card-meta { display: flex; gap: .75rem; flex-wrap: wrap; align-items: center; }
.art-badge-proceso {
  font-family: 'Space Mono', monospace;
  font-size: .6rem; letter-spacing: .1em; text-transform: uppercase;
  background: #fef9c3; color: #854d0e;
  border: 1px solid #fde68a; border-radius: 99px;
  padding: .2rem .7rem;
}
.art-card-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.3rem; font-weight: 600;
  color: var(--navy); line-height: 1.3;
}
.art-card-desc {
  font-size: .85rem; color: var(--muted); line-height: 1.75;
}
.art-card-foot {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: .75rem; margin-top: .25rem;
}
.art-tags { display: flex; flex-wrap: wrap; gap: .4rem; }
.art-en-proceso {
  display: flex; align-items: center; gap: .4rem;
  font-family: 'Space Mono', monospace;
  font-size: .6rem; letter-spacing: .08em; color: var(--blue);
}
.art-nota {
  margin-top: 3rem;
  text-align: center;
  font-size: .88rem; color: var(--muted);
  padding: 1.5rem;
  border-top: 1px solid var(--border-lt);
}
.art-nota-link { color: var(--blue); font-weight: 600; text-decoration: none; }
.art-nota-link:hover { text-decoration: underline; }

@media (max-width: 600px) {
  .art-card { grid-template-columns: 1fr; }
  .art-card-icon { min-height: 60px; border-right: none; border-bottom: 1px solid var(--border-lt); }
  .art-card-foot { flex-direction: column; align-items: flex-start; }
}
</style>